{
  "expo": {
    "name": "Caderno",
    "slug": "caderno",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icone/ios-1024.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f5ead8",
    "android": {
      "package": "br.com.caderno.notas",
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/icone/ic_launcher-512.png",
      "adaptiveIcon": {
        "backgroundColor": "#8fa073",
        "foregroundImage": "./assets/icone/ic_launcher_foreground.png",
        "monochromeImage": "./assets/icone/ic_launcher_monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/icone/ios-1024.png"
    },
    "web": {
      "favicon": "./assets/icone/ic_launcher-192.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Caderno usa suas fotos para anexá-las às notas."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icone/splash_icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#8fa073"
        }
      ]
    ]
  }
}
